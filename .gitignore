# Python cache & build
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# Virtual environments & secrets
.venv/
venv/
env/
.env

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Trained model artifacts (heavy binaries)
models/*.pkl
models/*.pt
models/*.pth
models/*.bin
models/*.safetensors
!models/.gitkeep

# Raw / large temporary data (keep sample processed CSV & .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/labeled/*
!data/labeled/.gitkeep

# OS & IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
