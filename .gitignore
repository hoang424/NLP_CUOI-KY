# Python cache & build
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# Virtual environments & secrets
.venv/
venv/
env/
.env

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Trained model artifacts (giữ sẵn *.pkl và *.pt ~29.6 MB để pull về chạy ngay; chỉ chặn file trọng số lớn khác)
models/*.pth
models/*.bin
models/*.safetensors
!models/.gitkeep

# Raw data (đóng gói sẵn để tái tạo đầy đủ từ 01_eda.ipynb; chỉ chặn file cache tạm & labeled lớn)
data/raw/*.story_cache.jsonl
data/labeled/*
!data/labeled/.gitkeep

# OS & IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
